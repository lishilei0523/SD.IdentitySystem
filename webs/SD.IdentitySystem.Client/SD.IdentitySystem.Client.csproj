<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Version>4.6.3</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>OS_WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>OS_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
    <None Update="Content\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Installers\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="8.0.22" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="9.0.11" />
    <PackageReference Include="MrAdvice" Version="2.19.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" Condition="'$(Configuration)'=='Release'" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" Condition="'$(Configuration)'=='Release'" />
    <PackageReference Include="SD.Toolkits.AspNet" Version="1.2.1" />
    <PackageReference Include="SD.Toolkits.AspNetCore" Version="2.3.2" />
    <PackageReference Include="SD.Toolkits.Json" Version="2.1.1" />
    <PackageReference Include="SD.Toolkits.Redis" Version="2.2.1" />
    <PackageReference Include="SD.Toolkits.Drawing" Version="1.1.1" />
    <PackageReference Include="SD.IOC.Core" Version="2.3.3" />
    <PackageReference Include="SD.IOC.Extension.NetCore" Version="2.3.3" />
    <PackageReference Include="SD.IOC.Extension.ServiceModel.Client" Version="2.3.3" />
    <PackageReference Include="SD.AOP.Core" Version="2.4.2" />
    <PackageReference Include="SD.AOP.Logger.SqlServer" Version="2.4.2" />
    <PackageReference Include="SD.CacheManager" Version="2.3.1" />
    <PackageReference Include="SD.CacheManager.Redis" Version="2.3.1" />
    <PackageReference Include="SD.Infrastructure" Version="3.8.3" />
    <PackageReference Include="SD.Infrastructure.AOP" Version="2.4.2" />
    <PackageReference Include="SD.IdentitySystem.IAppService" Version="4.6.3" />
    <PackageReference Include="SD.IdentitySystem.AspNetCore.Authentication" Version="2.2.4" />
    <PackageReference Include="SD.IdentitySystem.WCF.Authentication.AspNetCore" Version="2.2.4" />
    <PackageReference Include="SD.IdentitySystem.Membership" Version="4.3.1" />
    <PackageReference Include="SD.IdentitySystem.Membership.AspNetCore" Version="2.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SD.IdentitySystem.Presentation\SD.IdentitySystem.Presentation.csproj" />
  </ItemGroup>
</Project>
