  <ItemGroup>
    <PackageReference Include="SD.Common" Version="4.0.1" />
    <PackageReference Include="SD.Toolkits.Mapper" Version="4.0.1" />
    <PackageReference Include="SD.Toolkits.Recursion" Version="4.0.1" />
    <PackageReference Include="SD.Infrastructure" Version="4.0.1" />
    <PackageReference Include="SD.Infrastructure.WPF" Version="4.0.0" />
    <PackageReference Include="SD.Infrastructure.WPF.Caliburn" Version="4.0.0" />
    <PackageReference Include="SD.IdentitySystem.IAppService" Version="4.6.3" />
  </ItemGroup>
