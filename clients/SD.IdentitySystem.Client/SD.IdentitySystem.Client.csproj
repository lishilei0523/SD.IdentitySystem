<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>Full</DebugType>
    <DebugSymbols>True</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
    <Resource Include="Content\Images\*.*" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Equals('net48'))">
    <None Include="App.Core.config">
      <DependentUpon>App.config</DependentUpon>
    </None>
    <Reference Include="System.ServiceModel" />
    <PackageReference Include="SD.IOC.Core" Version="1.4.2" />
    <PackageReference Include="SD.IdentitySystem.WCF.Authentication.Common" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Equals('net10.0-windows'))">
    <None Remove="App.config" />
    <AppConfigWithTargetPath Include="App.Core.config">
      <TargetPath>$(AssemblyName).dll.config</TargetPath>
    </AppConfigWithTargetPath>
    <PackageReference Include="SD.IOC.Core" Version="3.0.2" />
    <PackageReference Include="SD.IOC.Extension.NetCore" Version="3.0.2" />
    <PackageReference Include="SD.IOC.Extension.Grpc" Version="3.0.2" />
    <PackageReference Include="SD.IdentitySystem.Grpc.Authentication.Common" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks.MaterialDesign" Version="6.2.1" />
    <PackageReference Include="FluentWPF" Version="0.10.2" />
    <PackageReference Include="BusyIndicator" Version="1.9.0">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    <PackageReference Include="MrAdvice" Version="2.20.6" />
    <PackageReference Include="SD.Common" Version="4.0.2" />
    <PackageReference Include="SD.Toolkits.Json" Version="4.0.2" />
    <PackageReference Include="SD.Toolkits.Recursion" Version="4.0.2" />
    <PackageReference Include="SD.Infrastructure" Version="4.0.2" />
    <PackageReference Include="SD.Infrastructure.WPF" Version="4.0.2" />
    <PackageReference Include="SD.Infrastructure.WPF.Caliburn" Version="4.0.2" />
    <PackageReference Include="SD.IdentitySystem.IAppService" Version="4.7.2" />
    <PackageReference Include="SD.IdentitySystem.Membership" Version="4.7.2" />
    <PackageReference Include="SD.IdentitySystem.Membership.Common" Version="4.7.2" />
    <PackageReference Include="SD.IdentitySystem.Authorization.WPF" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SD.IdentitySystem.Presentation\SD.IdentitySystem.Presentation.csproj" />
  </ItemGroup>
</Project>
