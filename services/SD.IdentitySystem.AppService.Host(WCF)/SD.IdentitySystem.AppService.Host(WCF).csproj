<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SD.IdentitySystem.AppService.Host</AssemblyName>
    <RootNamespace>SD.IdentitySystem.AppService.Host</RootNamespace>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>OS_WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>OS_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
    <None Include="App.config" Condition="'$(Configuration)'=='Debug'">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>ef.dll.config</TargetPath>
    </None>
    <None Include="Installers\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.NetTcp" Version="1.9.1" />
    <PackageReference Include="CoreWCF.ConfigurationManager" Version="1.9.1">
      <ExcludeAssets Condition="'$(Configuration)'=='Debug'">contentFiles</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
    <PackageReference Include="MrAdvice" Version="2.20.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" Condition="'$(Configuration)'=='Release'" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" Condition="'$(Configuration)'=='Release'" />
    <PackageReference Include="SD.Toolkits.AspNet" Version="4.0.2" />
    <PackageReference Include="SD.Toolkits.AspNetCore" Version="4.0.2" />
    <PackageReference Include="SD.Toolkits.Redis" Version="4.0.4" />
    <PackageReference Include="SD.IOC.Core" Version="3.0.2" />
    <PackageReference Include="SD.IOC.Extension.NetCore" Version="3.0.2" />
    <PackageReference Include="SD.IOC.Integration.WCF" Version="3.0.2" />
    <PackageReference Include="SD.AOP.Core" Version="3.0.2" />
    <PackageReference Include="SD.AOP.Logger.SqlServer" Version="3.0.2" />
    <PackageReference Include="SD.CacheManager" Version="3.0.2" />
    <PackageReference Include="SD.CacheManager.Redis" Version="3.0.3" />
    <PackageReference Include="SD.Infrastructure" Version="4.0.2" />
    <PackageReference Include="SD.Infrastructure.AOP" Version="4.0.2" />
    <PackageReference Include="SD.Infrastructure.WCF.Server" Version="4.0.2" />
    <PackageReference Include="SD.IdentitySystem.Membership" Version="4.7.2" />
    <PackageReference Include="SD.IdentitySystem.Membership.WCF" Version="4.7.2" />
    <PackageReference Include="SD.IdentitySystem.WCF.Authentication" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SD.IdentitySystem.AppService\SD.IdentitySystem.AppService.csproj" />
    <ProjectReference Include="..\SD.IdentitySystem.IAppService\SD.IdentitySystem.IAppService.csproj" />
    <ProjectReference Include="..\SD.IdentitySystem.Domain\SD.IdentitySystem.Domain.csproj" />
    <ProjectReference Include="..\SD.IdentitySystem.Repository\SD.IdentitySystem.Repository.csproj" />
  </ItemGroup>
</Project>
